# Postgres connection string. On Vercel, add the Neon integration
# (Storage tab -> Marketplace Database Providers -> Neon) and it will set
# DATABASE_URL for you automatically. For local dev, create a free Neon
# project at https://neon.tech and paste its connection string here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional. When set, the whole app is gated behind this shared passcode
# (see /unlock). Leave unset to keep the app open to anyone with the link.
PARTY_PASSCODE=""
